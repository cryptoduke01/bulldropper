    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tweetnacl": "^1.0.3",
    "undici": "^6.20.1",
    "zod": "^3.23.8"
