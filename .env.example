# twitterapi.io — sign up at https://twitterapi.io, paste the key
TWITTERAPI_IO_KEY=

# Optional — defaults shown
# Time window (hours) to look back when scanning
SCAN_HOURS=24
# Max tweets to fetch from twitterapi.io (pagination cap)
SCAN_MAX_TWEETS=500
# Number of top authors to keep in the output CSV
SCAN_TOP_N=100
# ms between paginated API calls. Free tier needs ~5500. Paid: 200-500 is fine.
SCAN_QPS_DELAY_MS=250
# Per author with no wallet found, scan this many of their recent tweets. 0 disables.
SCAN_RECENT_TWEETS_PER_AUTHOR=40

# Solana RPC URL for client-side wallet operations (balance checks, blockhash, sending airdrops).
# Use a private RPC like Helius or QuickNode for production reliability and speed.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
NEXT_PUBLIC_SOLANA_RPC=

# Privy App ID for X login and wallet embedding (get from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=cmqzvgizz007e0ck16ntvr8kc

# Privy App Secret (server-only, used to verify X OAuth claims in /api/claim). Never expose as NEXT_PUBLIC_*
PRIVY_APP_SECRET=privy_app_secret_...

